# Copia este archivo como "keystore.properties" (en la raíz del proyecto) y
# rellena tus propios valores. Ese archivo NO se sube al repositorio.
#
# Para generar tu keystore de firma:
#   keytool -genkeypair -v -keystore difusion-release.jks \
#     -alias difusion -keyalg RSA -keysize 2048 -validity 10000

storeFile=difusion-release.jks
storePassword=CAMBIA_ESTA_CLAVE
keyAlias=difusion
keyPassword=CAMBIA_ESTA_CLAVE
